{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goteo-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/l/*", "/u/*", "/oauth/*", "/img/*"] },
  // Cada 5 min. El ritmo real lo marca cada buzón (huecos irregulares de 10-40 min).
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goteo-mail",
      // Rellena con el id que devuelve `npx wrangler d1 create goteo-mail`
      "database_id": "efc94173-f1c6-43bc-8247-54ea8f4060f2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Dirección pública del Worker (mejor un dominio propio que *.workers.dev:
    // los enlaces en dominios compartidos tienen mala reputación antispam).
    "PUBLIC_URL": "https://goteo-mail.cmoreno-837.workers.dev"
  }
  // Secretos (npx wrangler secret put …): ADMIN_PASSWORD, ENC_KEY, ALERT_EMAIL (opcional),
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, MS_CLIENT_ID, MS_CLIENT_SECRET
}
